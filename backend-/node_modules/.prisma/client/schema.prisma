generator client {
  provider   = "prisma-client-js"
  engineType = "wasm"
}

datasource db {
  provider = "postgresql"
}

// ─── RSGE ─────────────────────────────────────────────────────────────────────
model Rsge {
  id            String              @id @default(cuid())
  email         String              @unique
  motDePasse    String
  prenom        String
  nom           String
  nasChiffre    String // AES-256-GCM encrypted
  dateNaissance DateTime
  telephone     String?
  adresse       String?
  ville         String?
  codePostal    String?
  noPermis      String?
  bureauCoordId String?
  bureauCoord   BureauCoordinateur? @relation(fields: [bureauCoordId], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

// ─── Bureau Coordinateur ──────────────────────────────────────────────────────
model BureauCoordinateur {
  id        String    @id @default(cuid())
  nom       String
  email     String
  telephone String?
  adresse   String?
  ville     String?
  rsge      Rsge[]
  rapports  Rapport[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── Parents ──────────────────────────────────────────────────────────────────
model Parent {
  id               String           @id @default(cuid())
  email            String           @unique
  prenom           String
  nom              String
  telephone        String?
  telephoneTravail String?
  adresse          String?
  ville            String?
  codePostal       String?
  typeContribution TypeContribution @default(REDUIT)
  enfants          EnfantParent[]
  ententes         EntenteService[]
  factures         Facture[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// ─── Enfants ──────────────────────────────────────────────────────────────────
model Enfant {
  id                  String           @id @default(cuid())
  prenom              String
  nom                 String
  dateNaissance       DateTime
  groupeAge           GroupeAge
  allergies           String?
  medicaments         String?
  conditionsMedicales String?
  nomMedecin          String?
  telephoneMedecin    String?
  nomHopital          String?
  photoUrl            String?
  actif               Boolean          @default(true)
  dateInscription     DateTime         @default(now())
  dateDepart          DateTime?
  parents             EnfantParent[]
  contactUrgence      ContactUrgence?
  presences           Presence[]
  ententes            EntenteService[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

// ─── Relation Enfant ↔ Parent ─────────────────────────────────────────────────
model EnfantParent {
  enfantId     String
  parentId     String
  relation     String // "mere", "pere", "tuteur", "grand-parent"
  estCustodial Boolean @default(true)
  enfant       Enfant  @relation(fields: [enfantId], references: [id], onDelete: Cascade)
  parent       Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([enfantId, parentId])
}

// ─── Contacts d'urgence ───────────────────────────────────────────────────────
model ContactUrgence {
  id             String  @id @default(cuid())
  enfantId       String  @unique
  prenom         String
  nom            String
  relation       String
  telephone1     String
  telephone2     String?
  autoriseDepart Boolean @default(false)
  enfant         Enfant  @relation(fields: [enfantId], references: [id], onDelete: Cascade)
}

// ─── Présences ────────────────────────────────────────────────────────────────
model Presence {
  id           String            @id @default(cuid())
  enfantId     String
  date         DateTime          @db.Date
  heureArrivee String? // "HH:mm"
  heureDepart  String? // "HH:mm"
  statut       StatutPresence
  motifAbsence String?
  note         String?
  feuilleId    String?
  enfant       Enfant            @relation(fields: [enfantId], references: [id])
  feuille      FeuilleAssiduite? @relation(fields: [feuilleId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([enfantId, date])
}

// ─── Feuilles d'assiduité ─────────────────────────────────────────────────────
model FeuilleAssiduite {
  id             String        @id @default(cuid())
  mois           Int
  annee          Int
  statut         StatutFeuille @default(BROUILLON)
  pdfUrl         String?
  dateGeneration DateTime?
  dateEnvoi      DateTime?
  dateConfirmBC  DateTime?
  presences      Presence[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([mois, annee])
}

// ─── Ententes de services ─────────────────────────────────────────────────────
model EntenteService {
  id               String            @id @default(cuid())
  parentId         String
  enfantId         String
  version          Int               @default(1)
  dateDebut        DateTime
  dateFin          DateTime?
  horaireType      String?
  joursPresence    String? // JSON: ["lundi","mardi",...]
  heureArrivee     String?
  heureDepart      String?
  tarifJournalier  Decimal           @db.Decimal(8, 2)
  typeContribution TypeContribution
  statut           StatutEntente     @default(BROUILLON)
  pdfUrl           String?
  signatureReqId   String?           @unique
  dateSignature    DateTime?
  parent           Parent            @relation(fields: [parentId], references: [id])
  enfant           Enfant            @relation(fields: [enfantId], references: [id])
  signatureRequete SignatureRequete? @relation(fields: [signatureReqId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// ─── Requêtes de signature (Dropbox Sign) ─────────────────────────────────────
model SignatureRequete {
  id            String          @id @default(cuid())
  dropboxSignId String?         @unique
  signataire    String
  email         String
  statut        StatutSignature @default(EN_ATTENTE)
  lienSignature String?
  dateEnvoi     DateTime        @default(now())
  dateSignature DateTime?
  entente       EntenteService?
  document      Document?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// ─── Facturation ─────────────────────────────────────────────────────────────
model Facture {
  id                String        @id @default(cuid())
  parentId          String
  mois              Int
  annee             Int
  nombreJours       Int
  tarifJournalier   Decimal       @db.Decimal(8, 2)
  montantBrut       Decimal       @db.Decimal(10, 2)
  montantSubvention Decimal       @default(0) @db.Decimal(10, 2)
  montantNet        Decimal       @db.Decimal(10, 2)
  statut            StatutFacture @default(GENEREE)
  pdfUrl            String?
  dateEnvoi         DateTime?
  datePaiement      DateTime?
  parent            Parent        @relation(fields: [parentId], references: [id])
  subventions       Subvention[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([parentId, mois, annee])
}

model Subvention {
  id        String  @id @default(cuid())
  factureId String
  type      String // "FAMILLE_QUEBEC", "MUNICIPALE"
  montant   Decimal @db.Decimal(10, 2)
  reference String?
  facture   Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
}

// ─── Documents ────────────────────────────────────────────────────────────────
model Document {
  id               String            @id @default(cuid())
  nom              String
  type             TypeDocument
  url              String
  taille           Int?
  parentId         String?
  enfantId         String?
  signatureReqId   String?           @unique
  estSigne         Boolean           @default(false)
  dateEnvoi        DateTime?
  signatureRequete SignatureRequete? @relation(fields: [signatureReqId], references: [id])
  createdAt        DateTime          @default(now())
}

// ─── Calendrier ───────────────────────────────────────────────────────────────
model CalendrierEvenement {
  id           String        @id @default(cuid())
  titre        String
  type         TypeEvenement
  dateDebut    DateTime
  dateFin      DateTime?
  touteJournee Boolean       @default(true)
  description  String?
  couleur      String?       @default("#3b82f6")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ─── Rapports ────────────────────────────────────────────────────────────────
model Rapport {
  id             String              @id @default(cuid())
  type           TypeRapport
  mois           Int?
  annee          Int
  pdfUrl         String?
  excelUrl       String?
  bcId           String?
  bureauCoord    BureauCoordinateur? @relation(fields: [bcId], references: [id])
  dateGeneration DateTime            @default(now())
  dateEnvoi      DateTime?
}

// ─── Enums ────────────────────────────────────────────────────────────────────
enum TypeContribution {
  REDUIT // contribution réduite (~$10/jour)
  PLEIN // taux plein
  EXONERE // exonéré
}

enum GroupeAge {
  POUPON // 0-18 mois
  BAMBIN // 18 mois - 3 ans
  PRESCOLAIRE // 3-5 ans
  SCOLAIRE // 5 ans +
}

enum StatutPresence {
  PRESENT
  ABSENT
  ABSENT_JUSTIFIE
  CONGE_FERIE
  FERMETURE
}

enum StatutFeuille {
  BROUILLON
  GENEREE
  ENVOYEE_BC
  CONFIRMEE_BC
}

enum StatutEntente {
  BROUILLON
  ENVOYEE_SIGNATURE
  SIGNEE
  EXPIREE
  ANNULEE
}

enum StatutSignature {
  EN_ATTENTE
  ENVOYE
  SIGNE
  REFUSE
  EXPIRE
}

enum StatutFacture {
  GENEREE
  ENVOYEE
  PAYEE
  ANNULEE
}

enum TypeDocument {
  ENTENTE_SERVICE
  FEUILLE_ASSIDUITÉ
  FACTURE
  RECU_IMPOT
  AUTORISATION
  AUTRE
}

enum TypeEvenement {
  FERIE
  FERMETURE
  FORMATION
  CONGE
  AUTRE
}

enum TypeRapport {
  ASSIDUITÉ_MENSUELLE
  INSCRIPTIONS
  FERMETURES
  FACTURATION_ANNUELLE
}
